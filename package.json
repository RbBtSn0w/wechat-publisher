{
  "name": "@rbbtsn0w/wechat-publisher",
  "version": "1.4.0-beta.1",
  "description": "WeChat Post Publisher CLI",
  "main": "dist/src/index.js",
  "bin": {
    "wechat-pub": "dist/bin/wechat-pub.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RbBtSn0w/wechat-publisher.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/wechat-pub.js",
    "start": "node dist/bin/wechat-pub.js",
    "test": "vitest run",
    "test:release": "node --test \"test/release-*.test.mjs\"",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js}'",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "keywords": [],
  "author": "RbBtSn0w",
  "license": "ISC",
  "dependencies": {
    "@rbbtsn0w/wechat-markdown": "^1.4.0",
    "axios": "^1.16.0",
    "bmp-ts": "^1.0.9",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "form-data": "^4.0.5",
    "sharp": "^0.35.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/form-data": "^2.2.1",
    "@types/node": "^20.19.37",
    "@types/yaml": "^1.9.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "eslint": "^8.57.1",
    "import-from-esm": "2.0.0",
    "prettier": "^3.8.1",
    "publint": "0.3.25",
    "semantic-release": "^25.0.0",
    "semver": "^7.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "directories": {
    "test": "test"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "templates",
    "skills",
    "docs",
    "README.md"
  ],
  "overrides": {
    "flatted": "3.4.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "npm": "12.2.2"
  }
}
