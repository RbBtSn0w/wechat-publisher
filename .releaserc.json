{
  "branches": [
    "main"
  ],
  "plugins": [
    "./.github/release-train/commit-semantics.mjs",
    [
      "./.github/release-train/release-commit-analyzer.mjs",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "./.github/release-train/release-notes-generator.mjs",
      {
        "preset": "conventionalcommits"
      }
    ],
    "./scripts/release-payload.mjs",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-input/final.tgz",
            "label": "Verified npm archive"
          },
          {
            "path": "release-input/final.json",
            "label": "Archive identity"
          },
          {
            "path": "release-input/receipts/*.json",
            "label": "Registry receipt"
          }
        ]
      }
    ]
  ],
  "releaseAnalysisPlugins": [
    "./.github/release-train/release-commit-analyzer.mjs",
    "./.github/release-train/release-notes-generator.mjs"
  ]
}
