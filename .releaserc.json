{
  "branches": [
    "main"
  ],
  "plugins": [
    "./scripts/commit-semantics.mjs",
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "./scripts/release-payload.mjs",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-input/final.tgz",
            "label": "Verified npm archive"
          },
          {
            "path": "release-input/final.json",
            "label": "Archive identity"
          },
          {
            "path": "release-input/receipts/*.json",
            "label": "Registry receipt"
          }
        ]
      }
    ]
  ]
}
